{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing gite configuration and personal preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user identifier" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "settings": { "type": "object" },
        "rooms": { "type": "array" },
        "guests": { "type": "array" },
        "bookings": { "type": "array" },
        "dailyMeals": { "type": "array" },
        "invoices": { "type": "array" },
        "housekeeping": { "type": "array" },
        "payments": { "type": "array" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores all authenticated gite owner data, rooms, bookings, guests, invoices, housekeeping and meals."
    }
  }
}
