# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE PAYMENT INTEGRATION CONFIGURATION
# -----------------------------------------------------------------------------
# 1. STRIPE_SECRET_KEY: Clé secrète d'API Stripe (commence par sk_test_... ou sk_live_...)
#    Obligatoire pour créer des sessions de paiement sécurisées côté serveur.
STRIPE_SECRET_KEY=""

# 2. VITE_STRIPE_PUBLISHABLE_KEY: Clé publique Stripe (commence par pk_test_... ou pk_live_...)
#    Utilisée par le client web React / Stripe.js.
VITE_STRIPE_PUBLISHABLE_KEY=""

# 3. STRIPE_WEBHOOK_SECRET: Clé de signature du Webhook Stripe (commence par whsec_...)
#    Permet de valider la provenance des événements de paiements Stripe récurrents.
STRIPE_WEBHOOK_SECRET=""
